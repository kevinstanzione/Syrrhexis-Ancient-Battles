 "commands": [
  {
   "id": "gods-steward",
   "name": "The God's Steward",
   "armies": [
    "sumer"
   ],
   "limit": 1,
   "text": "Until the end of the round, every unit in your army without the Mercenary rule gains Frenzy.",
   "flavor": "The king rules as steward of the city's god, and the god's people fight for him."
  },
  {
   "id": "shields-of-lagash",
   "name": "Shields of Lagash",
   "armies": [
    "sumer"
   ],
   "limit": 1,
   "text": "Ongoing. At the End of the Round, each friendly unit with a Shield or Heavy Shield that has a Hold Action Token and is not Locked in Combat moves directly forward up to half its Move value, stopping 1” from any enemy unit. It keeps its Hold Action Token. Discard this card as soon as a friendly unit with a Shield or Heavy Shield is Locked in Combat.",
   "flavor": "Behind a wall of shields, the men of Lagash tread down the dead of Umma."
  },
  {
   "id": "battle-net-of-ningirsu",
   "name": "Battle Net of Ningirsu",
   "armies": [
    "sumer"
   ],
   "limit": 1,
   "text": "Until the end of the round, enemy units Locked in Combat with your units cannot leave the Melee. They cannot Flee (a unit that would Flee stays Locked in Combat and keeps its Flee Action Token), Disengage, or make a Withdraw Combat Move.",
   "flavor": "Ningirsu casts his great net over the men of Umma, and none escape."
  },
  {
   "id": "muriq-tidnim",
   "name": "Muriq-Tidnim",
   "armies": [
    "sumer"
   ],
   "limit": 1,
   "text": "Obstacle. Before deployment, place a wall up to 8” long and ½” wide anywhere within 6” of your deployment zone. No unit may move across it. It does not block Line of Sight. Shooting attacks that pass over it treat the target as in at least Light Cover. Enemy units with Scout or Ambush cannot be deployed within 12” of it.",
   "flavor": "Shu-Sin raises the wall that keeps the Amorites away."
  }
 ]
